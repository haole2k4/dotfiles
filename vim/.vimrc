set nocompatible

set number  	          "hien thi so dong 
set relativenumber      "dong hien tai la so 0

set showmatch           "to mau cap ngoac

set smartindent         "can le va dieu chinh dua theo cu phap
set autoindent          "sao chep thut le cua dong truoc

set whichwrap+=<,>,h,l  "di chuyen con tro cuoi dong sang dong ke

set tabstop=2
set shiftwidth=2
set expandtab 	        "chuyen doi tab thanh space

set hlsearch            "highlight searches

syntax on
filetype plugin indent on 
